{
  "excludeFiles": ["**/node_modules/**", "**/.git/**", "**/build/**", "**/.docusaurus/**"],
  "extensions": [".md"],
  "rules": {
    "no-empty-code-lang": 2,
    "no-empty-url": 2,
    "no-empty-list": 2,
    "no-empty-code": 2,
    "no-empty-inline-code": 2,
    "no-empty-blockquote": 2,
    "no-special-characters": 0,
    "use-standard-ellipsis": 0,
    "no-full-width-number": 0,
    "no-space-in-link": 2,
    "no-multiple-space-blockquote": 2,
    "correct-title-trailing-punctuation": 0,
    "no-space-in-inline-code": 2,
    "no-long-code": 0,
    "no-half-width-punctuation": 0,
    "require-trailing-spaces": 0,
    "space-around-link": 0,
    "no-multiple-blank-lines": 2,
    "space-around-alphabet": 2,
    "space-around-number": 2
  }
}
